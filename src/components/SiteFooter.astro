---
import Lily from './Lily.astro';
const year = new Date().getFullYear();
// TODO(penguin): confirm handles / add HTB profile id
const links = [
  { href: 'https://github.com/fxf61', label: 'GitHub', handle: 'fxF61' },
  { href: 'https://profile.hackthebox.com/profile/019d298d-7ffb-713c-9592-55789129b78e', label: 'Hack The Box', handle: 'fxF61' },
];
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__sign">
      <Lily variant="head" class="site-footer__lily" />
      <p class="site-footer__line">
        <span class="kanji" lang="ja">彼岸花</span>
        <span class="site-footer__gloss">the flower of the other shore</span>
      </p>
    </div>

    <ul class="site-footer__links" role="list">
      {links.map((l) => (
        <li><a href={l.href} rel="me noopener">{l.label}<span class="mono"> / {l.handle}</span></a></li>
      ))}
    </ul>

    <p class="site-footer__small meta">
      © {year} penguin · writeups cover retired machines only
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    border-top: var(--hairline);
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
    grid-template-columns: 1fr auto;
    align-items: end;
  }
  .site-footer__sign { display: flex; align-items: center; gap: var(--space-m); }
  .site-footer :global(.site-footer__lily) { width: 3.2rem; flex: none; }
  .site-footer__line { display: grid; line-height: 1.3; }
  .site-footer__line .kanji { font-size: var(--step-1); color: var(--lily-deep); }
  .site-footer__gloss { font-family: var(--font-display); font-style: italic; color: var(--mute); }

  .site-footer__links {
    display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-l);
    padding: 0; list-style: none;
    font-size: var(--step--1);
  }
  .site-footer__links a { text-decoration: none; color: var(--ink-soft); }
  .site-footer__links a:hover { color: var(--lily-deep); }
  .site-footer__links .mono { color: var(--mute); font-size: 0.85em; }
  .site-footer__small { grid-column: 1 / -1; }

  @media (max-width: 40rem) {
    .site-footer__inner { grid-template-columns: 1fr; align-items: start; }
  }
</style>
