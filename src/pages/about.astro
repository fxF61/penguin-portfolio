---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Lily from '../components/Lily.astro';

// cert badges (raster → optimized); pro-lab logos are SVG (imported as URLs)
import cptsImg from '../assets/images/certs/cert-cpts.png';
import crtoImg from '../assets/images/certs/cert-crto.png';
import zephyrUrl from '../assets/images/certs/prolab-zephyr.svg?url';
import offshoreUrl from '../assets/images/certs/prolab-offshore.svg?url';
import danteUrl from '../assets/images/certs/prolab-dante.svg?url';

const certs = [
  { img: cptsImg, label: 'HTB CPTS' },
  { img: crtoImg, label: 'CRTO' },
];
const prolabs = [
  { url: zephyrUrl, label: 'Zephyr' },
  { url: offshoreUrl, label: 'Offshore' },
  { url: danteUrl, label: 'Dante' },
];

const path = [
  { when: 'Now', what: 'Computer Science graduate — security focus' },
  { when: 'Ongoing', what: 'Hack The Box — Pro Labs & red team tradecraft' },
  { when: 'Next', what: 'Windows internals, shellcode & custom tooling' },
];

const HTB_URL = 'https://profile.hackthebox.com/profile/019d298d-7ffb-713c-9592-55789129b78e';

const skills = {
  'Active Directory': ['Kerberos abuse', 'AD CS / ESC paths', 'BloodHound', 'ACL abuse', 'DCSync'],
  'Offensive internals': ['Shellcode', 'Process injection', 'Reflective loading', 'ETW / EDR evasion'],
  'Tradecraft': ['Enumeration', 'Privilege escalation', 'Lateral movement', 'Pivoting'],
  'Tooling': ['Impacket', 'NetExec', 'Certipy', 'Ligolo-ng', 'Sliver'],
  'Foundations': ['Linux', 'Windows internals', 'Networking', 'Python', 'PowerShell'],
};
---
<Base title="About" intensity="atmosphere" topVeil>
  <section class="wrap about-wrap">
    <!-- delicate spider lily corner accent (decoration only) -->
    <div class="about__art" aria-hidden="true">
      <Lily variant="bloom-1" tone="line" class="about__lily" />
    </div>

    <div class="about-doc">
      <!-- 1 · INTRO ---------------------------------------------------- -->
      <header class="about-hero">
        <p class="eyebrow eyebrow--lily">彼岸花 · the other shore</p>
        <h1 class="display about__title">I'm <em>penguin</em>.</h1>
        <div class="about__body">
          <p class="lede">
            I am a Computer Science graduate and an offensive security researcher
            passionate about understanding how attackers operate at the lowest levels.
          </p>
          <p>
            This portfolio documents my hands-on journey through Active Directory
            exploitation, malware research, and red team tradecraft.
          </p>
          <p class="meta">Also known as <span class="mono">fxF61</span>.</p>
        </div>
      </header>

      <!-- 2 · RESEARCH FOCUS ------------------------------------------- -->
      <section class="about-section">
        <h2 class="display">Research focus</h2>
        <p class="about-prose">
          My current research centers on offensive Windows internals, particularly how
          legitimate operating system features can be abused for code execution and
          evasion. I'm currently learning to write my own shellcode, study process
          injection techniques (DLL injection, reflective loading, thread hijacking),
          and explore how modern EDRs detect (or miss) these behaviours at the API and
          ETW level.
        </p>
      </section>

      <!-- 3 · CERTIFICATES -------------------------------------------- -->
      <section class="about-section">
        <h2 class="display">Certificates</h2>
        <ul class="badge-grid" role="list">
          {certs.map((c) => (
            <li class="badge">
              <Image class="badge__img" src={c.img} width={220} alt={c.label} />
              <span class="badge__label">{c.label}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 4 · HTB PRO LABS -------------------------------------------- -->
      <section class="about-section">
        <h2 class="display">HTB Pro Labs</h2>
        <ul class="badge-grid" role="list">
          {prolabs.map((p) => (
            <li class="badge">
              <img class="badge__img" src={p.url} alt={p.label} loading="lazy" decoding="async" />
              <span class="badge__label">{p.label}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 5 · WHERE I AM ---------------------------------------------- -->
      <section class="about-section">
        <h2 class="display">Where I am</h2>
        <ol class="path__list" role="list">
          {path.map((p) => (
            <li class="path__row">
              <span class="path__when eyebrow">{p.when}</span>
              <span class="path__what">{p.what}</span>
            </li>
          ))}
        </ol>
      </section>

      <!-- 6 · CONNECT (icon row) -------------------------------------- -->
      <section class="about-section">
        <h2 class="display">Connect</h2>
        <p class="about-prose about-prose--tight">Interested in collaborating or discussing security?</p>
        <ul class="social" role="list">
          <li>
            <a class="social__link" href="https://github.com/fxF61" aria-label="GitHub" rel="me noopener" target="_blank">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            </a>
          </li>
          <li>
            <a class="social__link" href={HTB_URL} aria-label="Hack The Box" rel="me noopener" target="_blank">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 20.33 7.25 20.33 16.75 12 21.5 3.67 16.75 3.67 7.25 Z"/></svg>
            </a>
          </li>
          <li>
            <a class="social__link" href="https://www.linkedin.com/in/falah-nizam" aria-label="LinkedIn" rel="me noopener" target="_blank">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </li>
          <li>
            <button class="social__link" type="button" data-copy="penguin09854" aria-label="Copy Discord username penguin09854">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9554 2.4189-2.1568 2.4189z"/></svg>
              <span class="social__tip" aria-hidden="true">penguin09854</span>
            </button>
          </li>
        </ul>
      </section>

      <!-- 7 · QUOTE --------------------------------------------------- -->
      <blockquote class="about-quote__q display">
        “The only way to learn hacking is by hacking.”
      </blockquote>

      <!-- 8 · WHAT I WORK WITH (appendix) ----------------------------- -->
      <section class="about-section about-appendix">
        <h2 class="display">What I work with</h2>
        <dl class="skills__grid">
          {Object.entries(skills).map(([group, items]) => (
            <div class="skills__group">
              <dt class="eyebrow">{group}</dt>
              <dd>
                <ul class="skills__list mono" role="list">
                  {items.map((s) => <li>{s}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
</Base>

<script>
  // Discord: copy the username to the clipboard with brief inline feedback.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      const tip = btn.querySelector('.social__tip');
      try { await navigator.clipboard.writeText(text); } catch (e) { /* no-op */ }
      if (tip) {
        const prev = tip.textContent;
        tip.textContent = 'Copied';
        btn.classList.add('is-copied');
        window.setTimeout(() => { tip.textContent = prev; btn.classList.remove('is-copied'); }, 1500);
      }
    });
  });
</script>

<style>
  /* one continuous column; the lily is an absolute corner accent beside it */
  .about-wrap { position: relative; padding-block: var(--space-3xl) var(--space-xl); }
  .about-doc { max-width: 44rem; position: relative; z-index: 1; }
  .about__art { position: absolute; top: var(--space-xl); right: 0; z-index: 0; pointer-events: none; }
  .about__art :global(.about__lily) { width: min(15rem, 26vw); opacity: 0.9; }

  .about__title { font-size: var(--step-5); margin-block: var(--space-xs) var(--space-l); }
  .about__body { display: grid; gap: var(--space-m); max-width: 54ch; color: var(--ink-soft); }

  .about-section { margin-block: var(--space-2xl); }
  .about-section > h2 { font-size: var(--step-2); margin-bottom: var(--space-l); }
  .about-prose { color: var(--ink-soft); font-size: var(--step-0); line-height: 1.6; }
  .about-prose--tight { margin-bottom: var(--space-l); }

  /* certificate / pro-lab badges */
  .badge-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--space-xl);
    grid-template-columns: repeat(3, minmax(0, max-content));
    justify-content: start;
  }
  .badge { display: grid; justify-items: center; gap: var(--space-s); text-align: center; }
  .badge__img {
    width: 5.5rem; height: 5.5rem; object-fit: contain; display: block;
    border-radius: var(--radius-m);
    transition: transform var(--dur-2) var(--ease-soft), box-shadow var(--dur-2) var(--ease-soft);
  }
  .badge:hover .badge__img { transform: translateY(-4px); box-shadow: 0 8px 22px color-mix(in srgb, var(--lily) 32%, transparent); }
  .badge__label { font-family: var(--font-label); font-size: var(--step--1); letter-spacing: var(--label-tracking); text-transform: var(--label-transform); color: var(--ink-soft); }

  /* where I am */
  .path__list { list-style: none; padding: 0; display: grid; gap: 0; }
  .path__row { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-m); padding-block: var(--space-s); border-top: var(--hairline); align-items: baseline; }
  .path__row:last-child { border-bottom: var(--hairline); }
  .path__what { font-family: var(--font-display); font-size: var(--step-1); }

  /* connect — icon row */
  .social { list-style: none; padding: 0; margin: 0; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .social__link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.75rem; height: 1.75rem; padding: 0; background: none; border: 0;
    color: var(--mute); cursor: pointer; position: relative;
    transition: color var(--dur-1) var(--ease-soft), transform var(--dur-1) var(--ease-soft);
  }
  .social__link svg { width: 1.5rem; height: 1.5rem; display: block; }
  .social__link:hover, .social__link:focus-visible { color: var(--lily); transform: scale(1.05); outline: none; }
  .social__link:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; border-radius: var(--radius-s); }
  .social__tip {
    position: absolute; bottom: calc(100% + 0.5rem); left: 50%; transform: translateX(-50%) translateY(2px);
    font-family: var(--font-mono); font-size: var(--step--2); white-space: nowrap;
    padding: 0.2em 0.55em; background: var(--ink); color: var(--paper); border-radius: var(--radius-s);
    opacity: 0; pointer-events: none; transition: opacity var(--dur-1), transform var(--dur-1);
  }
  .social__link:hover .social__tip, .social__link:focus-visible .social__tip, .social__link.is-copied .social__tip {
    opacity: 1; transform: translateX(-50%) translateY(0);
  }

  /* closing quote */
  .about-quote__q {
    margin-block: var(--space-3xl) var(--space-2xl);
    font-size: var(--step-3); font-style: italic; color: var(--ink);
    line-height: var(--leading-snug); max-width: 30ch;
    padding-left: var(--space-l); border-left: 2px solid color-mix(in srgb, var(--lily) 55%, transparent);
  }

  /* appendix: tech stack */
  .skills__grid { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
  .skills__group dt { margin-bottom: var(--space-xs); }
  .skills__list { list-style: none; padding: 0; display: grid; gap: 0.3em; font-size: var(--step--1); color: var(--ink-soft); }
  .skills__list li { position: relative; padding-left: 1em; }
  .skills__list li::before { content: '·'; position: absolute; left: 0; color: var(--lily); }

  @media (max-width: 52rem) {
    .about__art { opacity: 0.5; }
    .about__art :global(.about__lily) { width: 9rem; }
    .badge-grid { grid-template-columns: repeat(2, minmax(0, max-content)); gap: var(--space-l); }
  }
  @media (max-width: 34rem) {
    .about__art { display: none; }                 /* avoid overlap on phones */
    .skills__grid { grid-template-columns: 1fr; }  /* stack appendix */
  }
</style>
