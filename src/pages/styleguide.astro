---
import Base from '../layouts/Base.astro';
import Lily from '../components/Lily.astro';
import Ornament from '../components/Ornament.astro';

// Extra fonts for pairings B and C — loaded here only, never on real pages.
import '@fontsource-variable/cinzel/wght.css';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/victor-mono/wght.css';
import '@fontsource/ibm-plex-mono/400.css';

const swatches = [
  ['--paper', 'paper', 'page'],
  ['--paper-raised', 'paper-raised', 'cards'],
  ['--paper-sunk', 'paper-sunk', 'code / wells'],
  ['--ink', 'ink', 'text · 16.8:1'],
  ['--ink-soft', 'ink-soft', 'secondary · 9.3:1'],
  ['--mute', 'mute', 'meta · 5.0:1'],
  ['--faint', 'faint', 'decorative only'],
  ['--lily', 'lily', 'accent · 5.4:1'],
  ['--lily-deep', 'lily-deep', 'hover · 9.2:1'],
  ['--lily-ink', 'lily-ink', 'darkest detail'],
  ['--rose', 'rose', 'floral fill'],
  ['--rose-soft', 'rose-soft', 'gradient top'],
  ['--blush', 'blush', 'tinted surface'],
  ['--mist', 'mist', 'cool haze'],
  ['--stem', 'stem', 'scapes'],
];
const steps = [
  ['--step-6', 'Hero display', '50 → 107'],
  ['--step-5', 'h1 / page title', '42 → 80'],
  ['--step-4', 'display', '35 → 60'],
  ['--step-3', 'h2', '29 → 45'],
  ['--step-2', 'h3', '25 → 34'],
  ['--step-1', 'h4 / lede', '20 → 25'],
  ['--step-0', 'body', '17 → 19'],
  ['--step--1', 'meta / small', '14.5 → 15'],
];
const pairings = [
  ['a', 'A · Hairline & ink', 'Cormorant · Newsreader · JetBrains Mono'],
  ['b', 'B · Epitaph', 'Cinzel · EB Garamond · IBM Plex Mono'],
  ['c', 'C · Modern requiem', 'Bodoni Moda · Inter · Victor Mono'],
];
---
<Base title="Styleguide" intensity="calm">
  <div class="wrap sg">
    <header class="sg__head">
      <p class="eyebrow eyebrow--lily">Design bible · Phase 0</p>
      <h1 class="display sg__title">The <em>higanbana</em> system</h1>
      <p class="lede">Every token, type, flower and component in one place. Switch the pairing to compare all three live — the rest of the site uses Pairing A.</p>
    </header>

    <!-- LIGHT / DARK COMPARISON -->
    <section class="sg__section" id="themes">
      <h2 class="sg__h">Light &amp; dark</h2>
      <p class="sg__note">Both themes share one token set via <code>light-dark()</code>. The nav toggle overrides the system preference and persists. All text pairings meet WCAG AA (ratios noted).</p>
      <div class="theme-cols">
        {(['light', 'dark'] as const).map((mode) => (
          <div class="theme-panel" style={`color-scheme:${mode}`}>
            <p class="theme-panel__tag eyebrow">{mode}</p>
            <div class="theme-panel__demo">
              <p class="eyebrow eyebrow--lily">Active Directory · CTF</p>
              <p class="display" style="font-size:var(--step-3)">Every root leaves <em>a stain.</em></p>
              <p style="color:var(--ink)">Body text — bone on paper. <span style="color:var(--mute)">Muted meta 7:1.</span> <a href="#themes">Crimson link.</a></p>
              <div class="row" style="margin:var(--space-s) 0">
                <a class="btn btn--solid" href="#themes">Read the writeups</a>
                <a class="btn btn--ghost" href="#themes">Who I am</a>
              </div>
              <div class="sw-row">
                {['--paper', '--paper-raised', '--paper-sunk', '--ink', '--mute', '--lily', '--lily-deep', '--rose', '--stem'].map((v) => (
                  <span class="sw" style={`background:var(${v})`} title={v}></span>
                ))}
              </div>
              <div class="card" style="margin-top:var(--space-s); padding:var(--space-m); background:var(--paper-raised); border:1px solid var(--rule); border-radius:var(--radius-m)">
                <span class="eyebrow" style="color:var(--mute)">Hack The Box</span>
                <p style="font-family:var(--font-display); font-size:var(--step-1); color:var(--ink)">Forest</p>
                <p class="mono" style="font-size:var(--step--2); color:var(--lily)">#active-directory</p>
              </div>
              <pre style="margin-top:var(--space-s)"><code>{`# recon
nmap -p- 10.10.10.161  # keyword string`}</code></pre>
            </div>
          </div>
        ))}
      </div>
    </section>

    <Ornament />

    <!-- PAIRING SWITCHER -->
    <section class="sg__section" id="pairings">
      <h2 class="sg__h">Font pairings</h2>
      <div class="pairing-switch" role="group" aria-label="Font pairing">
        {pairings.map(([id, name, stack]) => (
          <button type="button" class="pairing-btn" data-set-pairing={id} aria-pressed={id === 'a' ? 'true' : 'false'}>
            <span class="pairing-btn__name">{name}</span>
            <span class="pairing-btn__stack mono">{stack}</span>
          </button>
        ))}
      </div>
      <div class="specimen">
        <p class="specimen__eyebrow eyebrow eyebrow--lily">Active Directory · retired</p>
        <p class="specimen__display display">Every root leaves <em>a stain.</em></p>
        <p class="specimen__body">Body copy in the pairing's text face. The quick brown fox jumps over the lazy dog, then AS-REP roasts <code>svc-alfresco</code> for good measure. Reading measure holds around 66 characters so long writeups stay comfortable across a full screen width.</p>
        <p class="specimen__mono mono">$ nmap -p- --min-rate 5000 10.10.10.161  # 0 1 8 → O l B</p>
      </div>
    </section>

    <Ornament />

    <!-- COLOUR -->
    <section class="sg__section" id="colour">
      <h2 class="sg__h">Colour</h2>
      <div class="swatches">
        {swatches.map(([v, name, note]) => (
          <figure class="swatch">
            <div class="swatch__chip" style={`background: var(${v})`}></div>
            <figcaption>
              <span class="swatch__name mono">{name}</span>
              <span class="swatch__note meta">{note}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="veil-demo">
        <span class="veil-demo__label meta">--veil-rose · hero / section tops</span>
      </div>
    </section>

    <Ornament />

    <!-- TYPE -->
    <section class="sg__section" id="type">
      <h2 class="sg__h">Type scale</h2>
      <div class="type-scale">
        {steps.map(([v, role, px]) => (
          <div class="type-row">
            <span class="type-row__meta mono">{v.replace('--', '')} · {px}px</span>
            <span class="type-row__sample" style={`font-size: var(${v}); font-family: ${v === '--step-0' || v === '--step--1' ? 'var(--font-body)' : 'var(--font-display)'}`}>Higanbana 彼岸花 — {role}</span>
          </div>
        ))}
      </div>
    </section>

    <Ornament />

    <!-- FLOWERS -->
    <section class="sg__section" id="flowers">
      <h2 class="sg__h">Higanbana artwork</h2>
      <p class="sg__note">Generated by <code>scripts/draw-lily.mjs</code> · geometry in SVG, every colour from CSS. Four tones × six variants.</p>
      <div class="lily-grid">
        <figure><Lily variant="bloom-1" tone="fill" /><figcaption class="meta">bloom-1 · fill</figcaption></figure>
        <figure><Lily variant="bloom-2" tone="line" /><figcaption class="meta">bloom-2 · line</figcaption></figure>
        <figure><Lily variant="bloom-3" tone="mist" /><figcaption class="meta">bloom-3 · mist</figcaption></figure>
        <figure class="lily-grid__row">
          <Lily variant="head" tone="fill" style="width:5rem" />
          <Lily variant="bud" tone="fill" style="width:2rem" />
          <Lily variant="petal" tone="fill" style="width:3rem" />
          <Lily variant="head" tone="ink" style="width:3rem" />
          <figcaption class="meta">head · bud · petal · ink</figcaption>
        </figure>
      </div>
    </section>

    <Ornament />

    <!-- COMPONENTS -->
    <section class="sg__section" id="components">
      <h2 class="sg__h">Components</h2>

      <h3 class="sg__h3">Buttons</h3>
      <div class="row">
        <a class="btn btn--solid" href="#">Solid</a>
        <a class="btn btn--ghost" href="#">Ghost</a>
      </div>

      <h3 class="sg__h3">Badges</h3>
      <div class="row mono">
        <span class="badge">Windows</span>
        <span class="badge" style="color:var(--stem);border-color:color-mix(in srgb,var(--stem) 55%,transparent)">Easy</span>
        <span class="badge" style="color:var(--lily);border-color:color-mix(in srgb,var(--lily) 40%,transparent)">Medium</span>
        <span class="badge" style="color:var(--lily-deep);border-color:color-mix(in srgb,var(--lily-deep) 45%,transparent)">Hard</span>
      </div>

      <h3 class="sg__h3">Callouts</h3>
      <div class="prose stack" style="--stack-space:var(--space-m); max-width:none">
        <div class="callout callout--note"><span class="callout__label">Note</span><p>The register I write in — context, not recipe.</p></div>
        <div class="callout callout--warning"><span class="callout__label">Warning</span><p>Detection leaves a signal worth understanding.</p></div>
        <div class="callout callout--loot"><span class="callout__label">Loot</span><p class="mono">Administrator :: [redacted]</p></div>
      </div>

      <h3 class="sg__h3">Code &amp; table</h3>
      <div class="prose" style="max-width:none">
        <pre><code>{`# recon
nmap -p- --min-rate 5000 -sC -sV 10.10.10.161
crackmapexec smb 10.10.10.161 -u '' -p ''`}</code></pre>
        <table>
          <thead><tr><th>Port</th><th>Service</th><th>Note</th></tr></thead>
          <tbody>
            <tr><td class="mono">88</td><td>Kerberos</td><td>realm identified</td></tr>
            <tr><td class="mono">389</td><td>LDAP</td><td>directory reachable</td></tr>
            <tr><td class="mono">445</td><td>SMB</td><td>share listing</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="sg__h3">Ornament</h3>
      <Ornament />
    </section>
  </div>
</Base>

<script is:inline>
  // live pairing switch — sets data-pairing on <html>, remembered per visit
  const root = document.documentElement;
  const saved = sessionStorage.getItem('sg-pairing');
  if (saved) applyPairing(saved);
  function applyPairing(id) {
    if (id === 'a') root.removeAttribute('data-pairing');
    else root.setAttribute('data-pairing', id);
    document.querySelectorAll('[data-set-pairing]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.getAttribute('data-set-pairing') === id));
    });
    try { sessionStorage.setItem('sg-pairing', id); } catch {}
  }
  document.querySelectorAll('[data-set-pairing]').forEach((b) => {
    b.addEventListener('click', () => applyPairing(b.getAttribute('data-set-pairing')));
  });
</script>

<style>
  .sg { padding-block: var(--space-2xl) var(--space-xl); }
  .sg__head { max-width: var(--wrap-narrow); margin-bottom: var(--space-2xl); display: grid; gap: var(--space-s); }
  .sg__title { font-size: var(--step-5); }
  .sg__section { margin-block: var(--space-2xl); }
  .sg__h { font-size: var(--step-3); margin-bottom: var(--space-l); }
  .sg__h3 { font-size: var(--step-1); margin-block: var(--space-xl) var(--space-m); color: var(--ink-soft); }
  .sg__note { color: var(--mute); margin-bottom: var(--space-l); max-width: 60ch; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-s); align-items: center; }

  /* light/dark comparison */
  .theme-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l); }
  .theme-panel {
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: var(--radius-m);
    padding: var(--space-l); overflow: clip;
  }
  .theme-panel__tag { display: block; margin-bottom: var(--space-s); }
  .theme-panel__demo { display: grid; gap: var(--space-xs); }
  .sw-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-xs); }
  .sw { width: 1.6rem; height: 1.6rem; border-radius: var(--radius-s); border: 1px solid var(--rule); }
  @media (max-width: 40rem) { .theme-cols { grid-template-columns: 1fr; } }

  /* pairing switch */
  .pairing-switch { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-s); margin-bottom: var(--space-xl); }
  .pairing-btn { display: grid; gap: 0.2rem; text-align: left; padding: var(--space-m); background: var(--paper-raised); border: var(--hairline); border-radius: var(--radius-m); transition: border-color var(--dur-1); }
  .pairing-btn:hover { border-color: var(--rose); }
  .pairing-btn[aria-pressed='true'] { border-color: var(--lily); box-shadow: inset 0 0 0 1px var(--lily); }
  .pairing-btn__name { font-family: var(--font-display); font-size: var(--step-1); }
  .pairing-btn__stack { font-size: var(--step--2); color: var(--mute); }

  .specimen { display: grid; gap: var(--space-m); padding: var(--space-xl); background: var(--paper-raised); border: var(--hairline); border-radius: var(--radius-m); }
  .specimen__display { font-size: var(--step-4); }
  .specimen__body { max-width: 66ch; color: var(--ink-soft); }

  /* swatches */
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--space-m); }
  .swatch { display: grid; gap: 0.4rem; }
  .swatch__chip { aspect-ratio: 3 / 2; border-radius: var(--radius-s); border: 1px solid var(--rule-strong); }
  .swatch figcaption { display: grid; gap: 0.1rem; }
  .swatch__name { font-size: var(--step--1); }
  .veil-demo { margin-top: var(--space-l); height: 7rem; border-radius: var(--radius-m); background: var(--veil-rose); border: var(--hairline); display: flex; align-items: end; padding: var(--space-s) var(--space-m); }

  /* type scale */
  .type-scale { display: grid; gap: var(--space-m); }
  .type-row { display: grid; grid-template-columns: 12rem 1fr; gap: var(--space-l); align-items: baseline; border-top: var(--hairline); padding-top: var(--space-s); }
  .type-row__meta { color: var(--mute); font-size: var(--step--2); }
  .type-row__sample { line-height: 1.1; }

  /* lily grid */
  .lily-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--space-xl); align-items: end; }
  .lily-grid figure { display: grid; gap: var(--space-s); justify-items: center; }
  .lily-grid figure :global(.lily) { width: min(100%, 14rem); }
  .lily-grid__row { grid-column: 1 / -1; grid-auto-flow: column; justify-content: start; align-items: end; gap: var(--space-l); }
  .lily-grid__row :global(.lily) { width: auto; }
  .lily-grid__row figcaption { grid-row: 2; grid-column: 1 / -1; }

  @media (max-width: 40rem) {
    .type-row { grid-template-columns: 1fr; gap: var(--space-2xs); }
  }
</style>
